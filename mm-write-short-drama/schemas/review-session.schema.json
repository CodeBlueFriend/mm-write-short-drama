{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Two-pass actual-text reading receipt",
  "required": [
    "schemaVersion",
    "sessionId",
    "stage",
    "inputs",
    "coverage",
    "chunks",
    "firstRead",
    "contextRevealed",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^READ-[a-f0-9]{12}$"
    },
    "stage": {
      "enum": [
        "treatment",
        "outline",
        "batch",
        "final"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1
    },
    "chunks": {
      "type": "array",
      "minItems": 1
    },
    "firstRead": {
      "type": [
        "object",
        "null"
      ]
    },
    "contextRevealed": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "reading_incomplete",
        "first_read_complete",
        "blocked",
        "passed"
      ]
    }
  }
}
