{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Evidence-backed full reading report",
  "required": [
    "sessionId",
    "stage",
    "reviewer",
    "complete",
    "coverage",
    "checks",
    "issues",
    "methods",
    "promiseAudit"
  ],
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "treatment",
        "outline",
        "batch",
        "final"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "const": true
    },
    "coverage": {
      "type": "array",
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "minItems": 4
    },
    "issues": {
      "type": "array"
    },
    "methods": {
      "type": "array",
      "minItems": 1
    },
    "promiseAudit": {
      "type": "array"
    }
  }
}
