# This does not match the public bundled library inside the skill directory.
/knowledge-base/cards/*.md
!/knowledge-base/cards/README.md
!/knowledge-base/cards/card-template.md
/knowledge-base/sources/*
!/knowledge-base/sources/README.md
/knowledge-base/archive/*
