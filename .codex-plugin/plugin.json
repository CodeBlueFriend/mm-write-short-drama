    "supportURL": "https://github.com/CodeBlueFriend/mm-write-short-drama/issues",
    "privacyPolicyURL": "https://github.com/CodeBlueFriend/mm-write-short-drama/blob/main/docs/plugin-privacy.md",
    "defaultPrompt": [
